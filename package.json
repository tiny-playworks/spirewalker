{
  "name": "forge-workshop",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ILoveChy/spirewalker.git"
  },
  "bugs": {
    "url": "https://github.com/ILoveChy/spirewalker/issues"
  },
  "homepage": "https://spirewalker.miaoduidui.workers.dev/",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "wrangler dev",
    "e2e:serve": "pnpm build && node scripts/serve-dist.mjs",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "test:e2e": "playwright test --project=desktop-chromium",
    "test:visual": "playwright test tests/e2e/visualCapture.spec.ts --project=desktop-1080p --project=desktop-1440p",
    "test:e2e:ui": "playwright test --ui",
    "lint": "rslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "phaser": "4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rsbuild/core": "2.1.0",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslint/core": "^0.7.0",
    "@rstest/adapter-rsbuild": "^0.11.3",
    "@rstest/core": "^0.11.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/webpack-plugin": "^2.3.27",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.113.0"
  },
  "npmClient": "pnpm",
  "pnpm": {
    "overrides": {
      "@rsbuild/core": "2.1.0"
    }
  }
}
