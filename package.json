{
  "name": "spirewalker",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ILoveChy/spirewalker.git"
  },
  "bugs": {
    "url": "https://github.com/ILoveChy/spirewalker/issues"
  },
  "homepage": "https://spirewalker.miaoduidui.workers.dev/",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "wrangler dev",
    "e2e:serve": "pnpm build && node scripts/serve-dist.mjs",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "test:e2e": "pnpm test:e2e:smoke",
    "test:e2e:smoke": "playwright test tests/e2e/mainMenu.spec.ts tests/e2e/mapToBattle.spec.ts tests/e2e/pwaSmoke.spec.ts --project=chromium",
    "test:e2e:full": "playwright test --grep-invert @visual",
    "test:visual": "playwright test tests/e2e/visualCapture.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "lint": "rslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "simulate:act1": "tsx scripts/run-act1-validation.ts",
    "simulate:act1-boss": "tsx scripts/run-act1-boss-attribution.ts",
    "simulate:act1-boss:validate": "tsx scripts/validate-act1-boss-change.ts",
    "simulate:act2-entry": "tsx scripts/run-act2-entry-validation.ts",
    "check:bundle-size": "tsx scripts/check-bundle-size.ts",
    "audit:cards": "tsx scripts/audit-cards.ts",
    "audit:card-art": "tsx scripts/audit-card-art.ts",
    "audit:relics": "tsx scripts/audit-relics.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rsbuild/core": "2.1.0",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslint/core": "^0.7.0",
    "@rstest/adapter-rsbuild": "^0.11.3",
    "@rstest/core": "^0.11.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.1",
    "@vanilla-extract/webpack-plugin": "^2.3.27",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.113.0"
  },
  "npmClient": "pnpm",
  "pnpm": {
    "overrides": {
      "@rsbuild/core": "2.1.0"
    }
  }
}
